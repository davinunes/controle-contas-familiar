# ── Banco de dados (MySQL Oracle externo) ────────────────────
DB_HOST=10.0.0.208
DB_PORT=3306
DB_NAME=azakdb
DB_USER=seu_usuario_mysql
DB_PASSWORD=sua_senha_mysql

# ── JWT (gere uma chave forte!) ──────────────────────────────
# Gerar: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=TROQUE_POR_UMA_CHAVE_FORTE_AQUI
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
JWT_REFRESH_EXPIRE_DAYS=30

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=/api
BACKEND_INTERNAL_URL=http://backend:8000

# ── CORS (separado por vírgula, ou * para dev) ───────────────
ALLOWED_ORIGINS=https://organize.davinunes.eti.br,https://organize.digitalinovation.com.br
